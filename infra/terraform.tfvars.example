# Copie este arquivo para "terraform.tfvars" e preencha com os valores reais.
# NUNCA suba o terraform.tfvars de verdade para o Git — ele tem o token do bot.
# O .gitignore deste projeto já está configurado para ignorá-lo.

aws_region         = "us-east-2"
project_name       = "agente-gastos"
telegram_bot_token = "COLE_AQUI_O_TOKEN_DO_SEU_BOT"
telegram_chat_id   = "COLE_AQUI_SEU_CHAT_ID"
s3_bucket_name     = "agente-gastos-midia-seu-nome" # precisa ser único globalmente no S3
